<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:background="@drawable/bg_nav_header"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="18dp">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_avatar_ring"
        android:padding="5dp">

        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/circle_bg"
            android:contentDescription="Profile"
            android:padding="10dp"
            android:src="@drawable/ic_profile"
            app:tint="@color/accent_navy" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:letterSpacing="0.04"
        android:text="@string/app_name"
        android:textColor="@color/text_on_header"
        android:textSize="17sp"
        android:textStyle="bold" />

    <View
        android:layout_width="32dp"
        android:layout_height="2dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_divider_gold" />

    <TextView
        android:id="@+id/tvEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.85"
        android:fontFamily="serif"
        android:text="selflearning@email.com"
        android:textColor="@color/text_on_header"
        android:textSize="13sp"
        android:textStyle="italic" />

</LinearLayout>